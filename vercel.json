{
  "version": 2,
  "name": "ozate-ciftlik-erp",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*)\\.(css|js|json|png|jpg|svg|ico)$",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/$1.$2"
    },
    {
      "src": "^/login$",
      "dest": "/login.html"
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/index.html"
    }
  ]
}
